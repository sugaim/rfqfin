{
  "name": "rfq-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "generate:api": "node ../../scripts/generate-api.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "quality": "node ../../scripts/quality.js --target ts",
    "quality:fix": "node ../../scripts/quality.js --target ts --fix"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.9.0",
    "ag-grid-community": "^36.0.0",
    "ag-grid-enterprise": "^36.2.0",
    "ag-grid-react": "^36.0.0",
    "antd": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
