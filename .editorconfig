root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.cs]
indent_size = 4
# Domain and Application use stable layer namespaces while folders express features.
dotnet_style_namespace_match_folder = false:silent
csharp_style_namespace_declarations = file_scoped:error
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_prefer_braces = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
# Once a list wraps, keep one argument/parameter/item on each line.
dotnet_diagnostic.RCS0053.severity = error
# Keep enum declarations and members on separate lines.
dotnet_diagnostic.RCS0031.severity = error
# Separate adjacent declarations when either declaration spans multiple lines.
dotnet_diagnostic.RCS0010.severity = error

[*.{csproj,props,targets}]
indent_size = 2

[tests/**/*.cs]
# These tests intentionally exercise exception instances as theory data.
dotnet_diagnostic.xUnit1045.severity = none
# Underscore-separated test names are the project's readability convention.
dotnet_diagnostic.CA1707.severity = none
# Exception taxonomy tests intentionally include a generic unexpected exception.
dotnet_diagnostic.CA2201.severity = none

[src/Rfq.Api/Me/*.cs]
# "Me" is the established HTTP feature name and route, not a public CLR API choice.
dotnet_diagnostic.CA1716.severity = none
