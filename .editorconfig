root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.cs]
indent_size = 4
# Domain and Application use stable layer namespaces while folders express features.
dotnet_style_namespace_match_folder = false:silent
csharp_style_namespace_declarations = file_scoped:error

[*.{csproj,props,targets}]
indent_size = 2
